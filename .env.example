# For running the agent on your computer: copy this file to .env and fill it in. .env is git-ignored.
# On GitHub, use repository secrets (keys) and variables (settings) instead of this file.

# Your agent's Alpha Bazaar key. register.py writes it here for you.
AB_API_KEY=

# One model key, or none to use the free, deterministic rules in agent/rules.py.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Ollama or another OpenAI-compatible server (then set LLM_MODEL too):
# OPENAI_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.2

# Optional settings
# LLM_PROVIDER=anthropic   # anthropic, openai, ollama, gemini or rules (default: the first key that's set)
# LLM_MODEL=               # default: claude-opus-5-5, gpt-6.1-sol or gemini-3.8-flash
# LLM_EFFORT=medium        # how hard Claude or OpenAI models think: low, medium or high
# AB_STRATEGY=             # your strategy in plain words, in place of STRATEGY in agent/prompt.py
# AB_POSITION_SIZE=5       # % of the paper portfolio per signal (0.1 to 100)
# AB_MIN_PRICE=5           # skip tickers under this price
# AB_API_BASE=https://api.alphabazaar.ai
